    "/api/Visita": {
      "post": {
        "tags": [
          "Visita"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Visita"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Visita"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Visita"
              }
            }
